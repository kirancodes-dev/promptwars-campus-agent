# CampusPilot AI backend configuration. Copy to backend/.env for local use.
# backend/.env is git-ignored. Never commit real values. In production use Secret Manager.

# --- AI planning (optional) ---
# Leave empty to use the built-in deterministic planner. Get a key from Google AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Storage (optional) ---
# false = in-memory demo storage (lost on restart). true = Google Cloud Firestore
# (uses Application Default Credentials; no key file needed on Cloud Run).
FIRESTORE_ENABLED=false
FIRESTORE_PROJECT_ID=

# --- Identity ---
# session (default): private anonymous session per browser (signed HttpOnly cookie).
# demo: everyone shares one demo user. Local single-user development only.
IDENTITY_MODE=session
# Signing key for session cookies. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# If empty, a random per-process key is used (sessions reset on restart).
SESSION_SECRET=

# --- Runtime ---
# production disables /docs, enables Secure cookies, and removes dev CORS origins.
APP_ENV=development
# Comma-separated extra origins allowed to call the API cross-origin (normally not needed).
CORS_ORIGINS=
RATE_LIMIT_PER_MINUTE=60
APPROVAL_TTL_SECONDS=900
MAX_REQUEST_BYTES=32768
TOOL_TIMEOUT_SECONDS=15
