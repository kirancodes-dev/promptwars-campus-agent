# Optional. Leave unset to call the API on the same origin (recommended).
# In development, `npm run dev` proxies /api to http://127.0.0.1:8000.
# Only set this when the API is hosted on a different origin.
# VITE_API_BASE_URL=

# Optional: where the dev proxy forwards /api (default http://127.0.0.1:8000).
# VITE_DEV_BACKEND=http://127.0.0.1:8000

# Never put secrets in VITE_* variables: they are bundled into public JavaScript.
